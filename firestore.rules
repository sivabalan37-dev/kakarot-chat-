rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function safeUserData() {
      return !request.resource.data.keys().hasAny([
        'password', 'googlePassword', 'idToken', 'accessToken',
        'refreshToken', 'credential', 'customToken', 'authToken'
      ]);
    }
    function chatOf(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function inChat(id) { return signedIn() && request.auth.uid in chatOf(id).participants; }

    match /users/{uid} {
      allow read: if mine(uid);
      allow create: if mine(uid)
        && request.resource.data.user_id == uid
        && safeUserData();
      allow update: if mine(uid)
        && resource.data.user_id == uid
        && request.resource.data.user_id == uid
        && safeUserData();
      allow delete: if false;
      match /blocked/{other} {
        allow read, write: if mine(uid);
      }
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if mine(uid)
        && request.resource.data.user_id == uid
        && !request.resource.data.keys().hasAny([
          'password', 'googlePassword', 'idToken', 'accessToken',
          'refreshToken', 'credential', 'customToken', 'email'
        ]);
      allow delete: if false;
    }

    // Reservations and username-to-email mappings are written only by
    // trusted Admin SDK Cloud Functions. Clients cannot enumerate or mutate them.
    match /usernames/{usernameLower} {
      allow read, write: if false;
    }
    match /usernameAuth/{usernameLower} {
      allow read, write: if false;
    }
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_message_at', 'last_message_text']);
    }

    match /messages/{messageId} {
      allow read: if inChat(resource.data.chat_id);
      allow create: if inChat(request.resource.data.chat_id)
        && request.resource.data.message_id == messageId
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.receiver_id != request.auth.uid
        && request.resource.data.receiver_id in chatOf(request.resource.data.chat_id).participants
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.attachment_url is string
        && request.resource.data.attachment_url.size() <= 2048
        && request.resource.data.deleted_for == []
        && request.resource.data.read_at == null
        && request.resource.data.delivered_at == null
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.receiver_id)/blocked/$(request.auth.uid));
      allow update: if inChat(resource.data.chat_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered_at', 'read_at', 'deleted_for'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['delivered_at', 'read_at'])
            || request.auth.uid == resource.data.receiver_id)
        && request.resource.data.deleted_for.toSet().difference(resource.data.deleted_for.toSet()).hasOnly([request.auth.uid])
        && resource.data.deleted_for.toSet().difference(request.resource.data.deleted_for.toSet()).hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter_id == request.auth.uid;
    }
  }
}
