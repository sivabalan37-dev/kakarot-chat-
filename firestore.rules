rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anything not matched below is denied by default.

    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function chatOf(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function inChat(id) { return signedIn() && request.auth.uid in chatOf(id).participants; }

    // Private account record: only its owner can read or change it.
    match /users/{uid} {
      allow read, create, update: if mine(uid);
      match /blocked/{other} { allow read, write: if mine(uid); }
    }

    // Public directory (name, photo, presence, hashed email) used for search and chat headers.
    // Only its owner can write it.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if mine(uid) && request.resource.data.user_id == uid;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && chatId.split('_').hasAll(request.resource.data.participants);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
    }

    match /messages/{messageId} {
      allow read: if inChat(resource.data.chat_id);
      allow create: if inChat(request.resource.data.chat_id)
        && request.resource.data.message_id == messageId
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.receiver_id != request.auth.uid
        && request.resource.data.receiver_id in chatOf(request.resource.data.chat_id).participants
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.deleted_for == []
        && request.resource.data.read_at == null
        && request.resource.data.delivered_at == null
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.receiver_id)/blocked/$(request.auth.uid));
      // Participants may only add themselves to deleted_for; only the receiver sets delivered/read.
      allow update: if inChat(resource.data.chat_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered_at', 'read_at', 'deleted_for'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['delivered_at', 'read_at'])
            || request.auth.uid == resource.data.receiver_id)
        && request.resource.data.deleted_for.toSet().difference(resource.data.deleted_for.toSet()).hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter_id == request.auth.uid;
    }
  }
}
