rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {

    function authed() { return request.auth != null; }

    // profiles: any signed-in user can look people up by email; only you edit your own
    match /users/{u} {
      allow read: if authed();
      allow write: if authed() && request.auth.uid == u;
    }

    // push tokens: private to the owner
    match /tokens/{u} {
      allow read, write: if authed() && request.auth.uid == u;
    }

    // reports: write-only (review them in the console)
    match /reports/{r} {
      allow create: if authed() && request.resource.data.by == request.auth.uid;
    }

    match /chats/{c} {
      function chat() { return get(/databases/$(d)/documents/chats/$(c)).data; }
      function mem() { return authed() && request.auth.uid in chat().members; }
      function free(i) { return !exists(/databases/$(d)/documents/chats/$(c)/blocks/$(chat().members[i])); }

      allow read: if authed() && request.auth.uid in resource.data.members;
      allow create: if authed() && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update: if authed() && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;

      match /messages/{m} {
        allow read: if mem();
        // nobody can send while either side has blocked
        allow create: if mem() && request.resource.data.from == request.auth.uid && free(0) && free(1);
        // only the receiver may flip "read" (read receipts)
        allow update: if mem() && resource.data.from != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // each user controls only their own block doc
      match /blocks/{b} {
        allow read: if mem();
        allow write: if mem() && request.auth.uid == b;
      }

      // WebRTC call signaling
      match /rtc/{x} {
        allow read, write: if mem();
      }
    }
  }
}
